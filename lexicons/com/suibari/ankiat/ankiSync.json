{
  "lexicon": 1,
  "id": "com.suibari.ankiat.ankiSync",
  "defs": {
    "main": {
      "type": "record",
      "description": "Anki 連携デッキごとの同期状態。rkey はデッキの rkey。",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "deck",
          "lastImportedRevlogId",
          "lastSyncedAt"
        ],
        "properties": {
          "deck": {
            "type": "string",
            "format": "at-uri"
          },
          "lastImportedRevlogId": {
            "type": "integer"
          },
          "lastPushedReviewLogRkey": {
            "type": "string",
            "format": "tid"
          },
          "pushedUntil": {
            "type": "string",
            "format": "datetime",
            "description": "回答の反映が途中で失敗したとき、送り終えた最後の回答の reviewedAt。lastPushedReviewLogRkey より後のレコードのうち、これ以前の回答は送らない。反映を最後まで終えたら消す"
          },
          "lastSyncedAt": {
            "type": "string",
            "format": "datetime"
          },
          "schedule": {
            "type": "array",
            "description": "同期時点で Anki が計算した各カードの期日",
            "items": {
              "type": "ref",
              "ref": "#scheduleEntry"
            }
          },
          "scheduleUpdatedAt": {
            "type": "string",
            "format": "datetime",
            "description": "schedule を計算した時刻。これより後に AnkiAt で回答したカードは AnkiAt の FSRS で期日を求める"
          }
        }
      }
    },
    "scheduleEntry": {
      "type": "object",
      "required": [
        "cardId",
        "kind"
      ],
      "properties": {
        "cardId": {
          "type": "string",
          "maxLength": 64
        },
        "kind": {
          "type": "string",
          "knownValues": [
            "review",
            "learning",
            "new",
            "suspended"
          ]
        },
        "dueAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    }
  }
}
